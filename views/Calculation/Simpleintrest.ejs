<!DOCTYPE html>
<html lang="hi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Simple Interest Calculator (Month & Year)</title>
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<style> 
/* 🌿 MAIN CONTAINER */
.calculator {
  background: #fff;
  padding: 30px;
  border-radius: 15px;
  box-shadow: 0 8px 25px rgba(0, 0, 0, 0.1);
  max-width: 100%;
  width: 95%;
  display: flex;
  gap: 30px;
  flex-wrap: wrap;
}

/* 🔢 LEFT PANEL */
.inputs {
  flex: 1.2;
}
h2 {
  margin-bottom: 15px;
  color: #333;
}

/* 🟢 TOGGLE BUTTONS */
.toggle {
  display: flex;
  background: #f1f3f5;
  border-radius: 30px;
  width: fit-content;
  margin-bottom: 20px;
}
.toggle button {
  border: none;
  padding: 8px 20px;
  cursor: pointer;
  border-radius: 30px;
  font-weight: 600;
  color: #555;
  background: transparent;
  transition: 0.2s;
}
.toggle button.active {
  background: #d3f9d8;
  color: #2f9e44;
}

/* 🧮 LABELS AND INPUT BOXES */
label {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 15px;
  font-weight: 600;
  color: #555;
}
input[type="number"] {
  width: 120px;
  padding: 6px;
  border: 1px solid #ccc;
  border-radius: 6px;
  text-align: right;
  color: #2f9e44;
  font-weight: 600;
}

/* 🌿 CUSTOM GREEN RANGE SLIDER */
input[type="range"] {
  width: 100%;
  margin: 8px 0 15px;
  -webkit-appearance: none;
  height: 8px;
  border-radius: 10px;
  background: #e9ecef;
  outline: none;
  --range-progress: 0%;
}

/* Chrome, Edge, Safari (progress fill) */
input[type="range"]::-webkit-slider-runnable-track {
  height: 8px;
  border-radius: 10px;
  background: linear-gradient(
    to right,
    #2f9e44 var(--range-progress),
    #e9ecef var(--range-progress)
  );
}
input[type="range"]::-webkit-slider-thumb {
  -webkit-appearance: none;
  width: 18px;
  height: 18px;
  border-radius: 50%;
  background: #2f9e44;
  cursor: pointer;
  margin-top: -5px;
  border: 2px solid white;
  box-shadow: 0 0 5px rgba(0, 0, 0, 0.2);
  transition: 0.2s;
}
input[type="range"]::-webkit-slider-thumb:hover {
  box-shadow: 0 0 8px #2f9e44;
}

/* Firefox support */
input[type="range"]::-moz-range-track {
  height: 8px;
  border-radius: 10px;
  background: #e9ecef;
}
input[type="range"]::-moz-range-progress {
  height: 8px;
  border-radius: 10px;
  background: #2f9e44;
}
input[type="range"]::-moz-range-thumb {
  width: 18px;
  height: 18px;
  border-radius: 50%;
  background: #2f9e44;
  cursor: pointer;
  border: 2px solid white;
  box-shadow: 0 0 5px rgba(0, 0, 0, 0.2);
}

/* 🧾 RESULTS BOX */
.results-inline {
  background: #f9fafb;
  border-radius: 10px;
  padding: 15px;
  margin-top: 10px;
  box-shadow: inset 0 0 5px rgba(0, 0, 0, 0.05);
}
.result-item {
  font-size: 16px;
  margin: 8px 0;
  color: #333;
}
.result-item b {
  color: #2f9e44;
}

/* 📊 CHART SECTION */
.chart-area {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
canvas {
  max-width: 100%;
  margin-top: 20px;
}

/* 💸 BUTTON STYLE */
.invest-btn {
  margin-top: 20px;
  background: #2f9e44;
  color: white;
  padding: 12px;
  border: none;
  border-radius: 8px;
  cursor: pointer;
  font-weight: 600;
  transition: 0.3s;
}
.invest-btn:hover {
  background: #218838;
}
</style>
</head>
<body>

<div class="calculator">
  <div class="inputs">
    <h2 id="title">💰 Month-wise Calculator</h2>
    <div class="toggle">
      <button id="monthBtn" class="active">Month wise</button>
      <button id="yearBtn">Year wise</button>
    </div>

    <label>
      Principal Amount (₹):
      <input type="number" id="amountInput" min="1" max="10000000" value="30000">
    </label>
    <input type="range" id="amount" min="1" max="1000000" value="30000">

    <label id="rateLabel">
      Interest Rate (% per month):
      <input type="number" id="rateInput" min="0" max="100" step="0.1" value="5">
    </label>
    <input type="range" id="rate" min="0" max="100" step="0.1" value="5">

    <label id="timeLabel">
      Time Period (months):
      <input type="number" id="timeInput" min="1" max="600" value="1">
    </label>
    <input type="range" id="time" min="1" max="600" value="1">

    <div class="results-inline">
      <div class="result-item">Invested Amount: ₹<b id="invested">0</b></div>
      <div class="result-item">Interest Earned: ₹<b id="returns">0</b></div>
      <div class="result-item">Total Value: ₹<b id="total">0</b></div>
    </div>
  </div>

  <div class="chart-area">
    <canvas id="chart" width="200" height="200"></canvas>
    <button class="invest-btn">INVEST NOW</button>
  </div>
</div>

<script>
// Mode control
let mode = "month";

// DOM elements
const amountInput = document.getElementById("amountInput");
const amountRange = document.getElementById("amount");
const rateInput = document.getElementById("rateInput");
const rateRange = document.getElementById("rate");
const timeInput = document.getElementById("timeInput");
const timeRange = document.getElementById("time");
const investedEl = document.getElementById("invested");
const returnsEl = document.getElementById("returns");
const totalEl = document.getElementById("total");
const title = document.getElementById("title");
const monthBtn = document.getElementById("monthBtn");
const yearBtn = document.getElementById("yearBtn");

// Chart.js setup
const ctx = document.getElementById("chart").getContext("2d");
let chart = new Chart(ctx, {
  type: "doughnut",
  data: {
    labels: ["Principal", "Interest"],
    datasets: [{
      data: [0, 0],
      backgroundColor: ["#2f9e44", "#4c6ef5"],
      borderWidth: 0
    }]
  },
  options: { cutout: "70%", plugins: { legend: { position: "bottom" } } }
});

function formatINR(x) {
  return x.toLocaleString("en-IN", { maximumFractionDigits: 0 });
}

// 🧮 Calculation logic
function calculate() {
  const P = parseFloat(amountInput.value) || 0;
  const R = parseFloat(rateInput.value) || 0;
  const T = parseFloat(timeInput.value) || 0;

  const interest = (P * R * T) / 100;
  const total = P + interest;

  investedEl.textContent = formatINR(P);
  returnsEl.textContent = formatINR(interest);
  totalEl.textContent = formatINR(total);

  chart.data.datasets[0].data = [P, interest];
  chart.update();
}

// 🔁 Sync sliders with input boxes
function syncInputs(input, range) {
  input.addEventListener("input", () => {
    range.value = input.value;
    updateSliderProgress(range);
    calculate();
  });
  range.addEventListener("input", () => {
    input.value = range.value;
    updateSliderProgress(range);
    calculate();
  });
}

// 🌿 Update green slider fill
function updateSliderProgress(slider) {
  const value = ((slider.value - slider.min) / (slider.max - slider.min)) * 100;
  slider.style.setProperty('--range-progress', value + '%');
}

// Apply sync to all sliders
syncInputs(amountInput, amountRange);
syncInputs(rateInput, rateRange);
syncInputs(timeInput, timeRange);

// Toggle logic
monthBtn.addEventListener("click", () => {
  mode = "month";
  monthBtn.classList.add("active");
  yearBtn.classList.remove("active");
  title.textContent = "💰 Month-wise Calculator";
  rateInput.value = 5; rateRange.value = 5;
  timeInput.value = 1; timeRange.value = 1;
  calculate();
});
yearBtn.addEventListener("click", () => {
  mode = "year";
  yearBtn.classList.add("active");
  monthBtn.classList.remove("active");
  title.textContent = "💰 Year-wise Calculator";
  rateInput.value = 12; rateRange.value = 12;
  timeInput.value = 1; timeRange.value = 1;
  calculate();
});
// Initialize
document.querySelectorAll('input[type="range"]').forEach(updateSliderProgress);
calculate();
</script>

</body>
</html>
